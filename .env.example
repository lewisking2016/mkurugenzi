# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, or paste the values
# into your host's environment settings on cPanel / your VPS.
# ---------------------------------------------------------------------------

# Database (MySQL or MariaDB — both cPanel and VPS provide one)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mkurugenzi
DB_USER=mkurugenzi_user
DB_PASSWORD=change-me
# Set to true only when your host requires a TLS connection.
DB_SSL=false
# Optional: cap concurrent connections on shared hosting.
DB_POOL_LIMIT=5

# Session signing secret. Generate with:  openssl rand -hex 32
# Must be at least 32 characters and different per environment.
SESSION_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# First admin account, used only by `npm run db:setup`.
ADMIN_EMAIL=admin@mkurugenzi.co.ke
ADMIN_PASSWORD=change-this-before-you-deploy
ADMIN_NAME=Admin

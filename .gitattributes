# Normalise line endings.
#
# The repo is developed on Windows but built and run on a Linux cPanel server. Git
# checks these files out with LF there, so a shell script that works locally cannot
# fail on the server with "^M: bad interpreter".
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
